{
  "name": "orbitpay-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MVP API scaffold for OrbitPay Kit C-address onboarding and payment intents.",
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test",
    "format:check": "node scripts/check-format.mjs",
    "api:smoke": "npm run build && node scripts/api-smoke.mjs",
    "start": "node dist/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
